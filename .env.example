# Copie para .env e preencha. NUNCA faça commit do .env.

# ── Supabase ──
# Project URL: Settings → Data API (ou botão "Connect")
VITE_SUPABASE_URL=https://pxynpgpjmwmetgjcqhap.supabase.co
# Settings → API Keys → Publishable key (sb_publishable_...) — ou a "anon" legada
VITE_SUPABASE_ANON_KEY=sb_publishable_dnECA9UZrwo09rFiQ3NgAg_gqAnqfdJ
# Settings → API Keys → Secret keys (sb_secret_...) — ou a "service_role" legada
# Só no servidor. Dá acesso total ao banco: nunca exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pluggy (meu.pluggy.ai → Applications) ──
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Mostrar o "Pluggy Bank" (banco de teste) no widget de conexão
VITE_PLUGGY_SANDBOX=true

# ── Webhooks da Pluggy ──
# URL pública HTTPS do app (em localhost a Pluggy não consegue chamar; use ngrok ou deixe vazio)
PUBLIC_APP_URL=
# Qualquer texto longo e aleatório; vai na URL do webhook para provar que a chamada é da Pluggy
PLUGGY_WEBHOOK_SECRET=

# ── Nivi (assistente com IA · Google Gemini) ──
# Crie em https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Opcional: modelo do Gemini (se o padrão sair de linha, o app escolhe outro "flash" sozinho)
GEMINI_MODEL=gemini-2.5-flash
# Privacidade: false = o Nivi recebe só totais por mês/categoria e saldos.
# true = também recebe a lista dos lançamentos dos últimos 45 dias (respostas mais precisas).
NIVI_ENVIAR_TRANSACOES=false
